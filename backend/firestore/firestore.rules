rules_version = '2';

// Matriz de autorización de ESPECIFICACION.md §13.2.
// Política: denegación por defecto; SOLO allow explícitos.
//
// Mecanismo de invitados (conocimiento del shareCode, validable en reglas):
//  1. El invitado (Auth anónimo) crea sessions/{sid}/guestAccess/{su uid}
//     incluyendo el shareCode; la regla lo compara con el de la sesión.
//  2. Todas sus lecturas posteriores se autorizan con exists(guestAccess).
//  Regenerar el shareCode + borrar guestAccess (owner) revoca el acceso.
//
// Escrituras de invitado, quirúrgicas y validadas campo a campo:
//  - participants: SOLO claimedByDevice (reclamar nombre libre / liberar el suyo).
//  - lines: SOLO su propia entrada en assignment.participants (modo byItem,
//    sesión abierta). El cliente declara assignment.lastEditorPid y la regla
//    verifica que (a) solo cambió esa clave y (b) ese pid está reclamado por él.
//  - settlements: SOLO pending→marked en liquidaciones donde él es `from`.
//
// Agregados (totals/balances/computeVersion) son SOLO-LECTURA para todos los
// clientes: los escribe la function recompute vía Admin SDK (ignora reglas).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isVerifiedAccount() {
      return signedIn()
        && request.auth.token.get('email_verified', false) == true;
    }

    // Invitado móvil o cuenta verificada. Una cuenta de correo pendiente
    // conserva lectura por UID, pero no puede realizar acciones de producto.
    function canUseCore() {
      return isAnonymous() || isVerifiedAccount();
    }

    // P3 social: verificación real + perfil público. La comprobación explícita
    // de anónimo es defensa en profundidad aunque sus tokens normales nunca
    // incluyan email_verified=true.
    function canUseSocial() {
      return isVerifiedAccount()
        && !isAnonymous()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    function sessionData(sid) {
      return get(/databases/$(database)/documents/sessions/$(sid)).data;
    }

    function ownsSession(sid) {
      return signedIn() && sessionData(sid).ownerUid == request.auth.uid;
    }

    function isOwner(sid) {
      return canUseCore() && ownsSession(sid);
    }

    function isOpen(sid) {
      return sessionData(sid).status == 'open';
    }

    function hasGuestAccess(sid) {
      return canUseCore()
        && exists(/databases/$(database)/documents/sessions/$(sid)/guestAccess/$(request.auth.uid));
    }

    function canRead(sid) {
      return ownsSession(sid) || hasGuestAccess(sid);
    }

    function claimedBy(sid, pid) {
      return get(/databases/$(database)/documents/sessions/$(sid)/participants/$(pid))
        .data.get('claimedByDevice', '');
    }

    // Receptor real de una liquidación (P2.1): el dispositivo que reclamó
    // ese participante; para nombres sin reclamar (sin uid), el owner actúa
    // como representante. Un nombre reclamado EXCLUYE al owner.
    function isReceiver(sid, pid) {
      let claimed = claimedBy(sid, pid);
      return (hasGuestAccess(sid) && claimed == request.auth.uid)
        || (isOwner(sid) && claimed == '');
    }

    // ── Perfil privado del anfitrión ────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isVerifiedAccount() && request.auth.uid == uid;

      match /frequentPeople/{personId} {
        allow read, write: if isVerifiedAccount() && request.auth.uid == uid;
      }
    }

    // ── Identidad pública (P2): perfil y unicidad de username ──────────
    // profiles/{uid} es el perfil PÚBLICO (users/{uid} sigue siendo privado).
    // El username es único e insensible a mayúsculas POR CONSTRUCCIÓN: se
    // almacena siempre en minúsculas y usernames/{username} es su claim de
    // unicidad. Claim y perfil se escriben en el MISMO batch y getAfter()
    // exige que ambos queden consistentes: no puede existir perfil sin claim
    // ni claim que el perfil no referencie.

    // La lista de reservados se duplica conscientemente en
    // packages/domain/lib/src/identity/username.dart (única otra copia).
    function validUsername(username) {
      return username is string
        && username.matches('^[a-z][a-z0-9_]{2,19}$')
        && !username.matches('.*__.*')
        && !username.matches('.*_$')
        && !(username in [
          'admin', 'administrador', 'salda', 'soporte', 'support', 'ayuda',
          'help', 'info', 'api', 'root', 'sistema', 'system', 'moderador',
          'mod', 'oficial', 'official', 'staff', 'equipo', 'team',
          'seguridad', 'security', 'invitado', 'guest', 'usuario', 'user',
          'anonimo', 'anonymous', 'test', 'prueba'
        ]);
    }

    function validProfile(uid) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'displayName', 'displayNameLower', 'username', 'photoPath',
          'createdAt', 'updatedAt', 'schemaVersion'
        ])
        && data.keys().hasAll([
          'displayName', 'displayNameLower', 'username',
          'createdAt', 'updatedAt', 'schemaVersion'
        ])
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 40
        // displayNameLower alimenta la búsqueda por prefijo. Las reglas no
        // pueden quitar diacríticos, así que solo exigen su forma (el
        // cliente que lo derive mal solo se hace más difícil de encontrar).
        && data.displayNameLower is string
        && data.displayNameLower.matches('^[a-z0-9 ]{1,40}$')
        && validUsername(data.username)
        && (!('photoPath' in data)
          || data.photoPath == null
          || data.photoPath == 'avatars/' + uid + '/avatar.jpg')
        && data.updatedAt is timestamp
        && data.schemaVersion == 1;
    }

    function claimAfterWrite(uid, username) {
      return getAfter(/databases/$(database)/documents/usernames/$(username))
        .data.uid == uid;
    }

    match /profiles/{uid} {
      // Público dentro del producto: cualquier identidad autenticada
      // (incluidos invitados) puede verlo y buscarlo por prefijo.
      allow read: if signedIn();
      allow create: if isVerifiedAccount()
        && request.auth.uid == uid
        && validProfile(uid)
        && request.resource.data.createdAt is timestamp
        && claimAfterWrite(uid, request.resource.data.username);
      allow update: if isVerifiedAccount()
        && request.auth.uid == uid
        && validProfile(uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && claimAfterWrite(uid, request.resource.data.username);
      allow delete: if isVerifiedAccount() && request.auth.uid == uid;
    }

    match /usernames/{username} {
      // Lectura autenticada: comprobar disponibilidad al elegir username.
      allow read: if signedIn();
      allow create: if isVerifiedAccount()
        && validUsername(username)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        // Atómico: el mismo batch debe dejar el perfil apuntando aquí.
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid))
            .data.username == username;
      // Liberar un username solo puede hacerlo su dueño (cambio o baja).
      allow delete: if isVerifiedAccount()
        && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ── Amistades (P3): una fuente de verdad por pareja de UID ─────────
    // El ID es el UTF-8 hexadecimal de los UID ordenados y serializados con
    // longitud. Es reversible, no secreto: su objetivo es evitar colisiones.
    // Cliente y Rules reproducen el mismo valor: no cabe una segunda relación
    // A↔B con otro orden ni se confía en username/displayName.
    function validFriendshipMembers(data, friendshipId) {
      return data.memberUids is list
        && data.memberUids.size() == 2
        && data.memberUids[0] is string
        && data.memberUids[1] is string
        && data.memberUids[0].size() >= 1
        && data.memberUids[0].size() <= 128
        && data.memberUids[1].size() >= 1
        && data.memberUids[1].size() <= 128
        && data.memberUids[0] < data.memberUids[1]
        && friendshipId == (
          string(data.memberUids[0].size()) + ':' + data.memberUids[0]
          + string(data.memberUids[1].size()) + ':' + data.memberUids[1]
        ).toUtf8().toHexString().lower()
        && data.requesterUid in data.memberUids
        && data.receiverUid in data.memberUids
        && data.requesterUid != data.receiverUid;
    }

    function validPendingFriendship(friendshipId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'memberUids', 'requesterUid', 'receiverUid', 'status',
          'createdAt', 'updatedAt', 'schemaVersion'
        ])
        && data.keys().hasAll([
          'memberUids', 'requesterUid', 'receiverUid', 'status',
          'createdAt', 'updatedAt', 'schemaVersion'
        ])
        && validFriendshipMembers(data, friendshipId)
        && data.status == 'pending'
        && data.schemaVersion == 1
        && data.requesterUid == request.auth.uid
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && exists(/databases/$(database)/documents/profiles/$(data.receiverUid));
    }

    match /friendships/{friendshipId} {
      allow read: if canUseSocial()
        && request.auth.uid in resource.data.memberUids;

      allow create: if canUseSocial()
        && validPendingFriendship(friendshipId);

      // Aceptar resuelve la solicitud en el MISMO documento. No existe una
      // segunda amistad ni una vista mutable que pueda quedar desincronizada.
      allow update: if canUseSocial()
        && resource.data.status == 'pending'
        && resource.data.receiverUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'acceptedAt', 'updatedAt'])
        && request.resource.data.status == 'friends'
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Pending: emisor cancela o receptor rechaza. Friends: cualquiera de
      // los dos elimina solo el vínculo social, nunca datos económicos.
      allow delete: if canUseSocial()
        && (
          (resource.data.status == 'pending'
            && request.auth.uid in [
              resource.data.requesterUid, resource.data.receiverUid
            ])
          || (resource.data.status == 'friends'
            && request.auth.uid in resource.data.memberUids)
        );
    }

    // ── P5 economía global: vistas derivadas + pagos autoritativos ──────
    // Ambos recursos los escribe exclusivamente Admin SDK (recompute o
    // callables). El cliente solo consulta los pares en los que participa.
    match /economicEntries/{entryId} {
      allow read: if canUseSocial()
        && request.auth.uid in resource.data.memberUids;
      allow create, update, delete: if false;
    }

    match /economicPayments/{paymentId} {
      allow read: if canUseSocial()
        && request.auth.uid in resource.data.memberUids;
      allow create, update, delete: if false;
    }

    // ── Espacios compartidos (P4, ADR-028) ─────────────────────────────
    // spaces/{id} + members/{uid} + spaceInvites/{spaceId_toUid}.
    // Membresía ≠ amistad ≠ participación económica: expulsar o salir solo
    // toca documentos sociales, jamás sesiones/tickets/balances/pagos.

    function spaceData(spaceId) {
      return get(/databases/$(database)/documents/spaces/$(spaceId)).data;
    }

    function isSpaceMember(spaceId) {
      return exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid));
    }

    function isSpaceOwner(spaceId) {
      return canUseSocial() && spaceData(spaceId).ownerUid == request.auth.uid;
    }

    function validSpaceShape(data) {
      return data.keys().hasOnly([
          'name', 'avatarEmoji', 'ownerUid', 'status',
          'createdAt', 'updatedAt', 'schemaVersion'
        ])
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 40
        && (!('avatarEmoji' in data)
          || (data.avatarEmoji is string && data.avatarEmoji.size() <= 8))
        && data.status in ['active', 'archived']
        && data.schemaVersion == 1
        && data.updatedAt is timestamp;
    }

    // El ROL no se persiste: el propietario único es spaces.ownerUid (fuente
    // única de verdad) y "miembro" es todo el que tiene doc de membresía.
    // Así la transferencia es la actualización de UN documento — atómica por
    // definición — y las reglas nunca necesitan get() sobre docs del mismo
    // batch (que fallaría).
    match /spaces/{spaceId} {
      allow read: if canUseSocial() && isSpaceMember(spaceId);

      // Alta atómica: espacio + SU membresía en el mismo batch.
      allow create: if canUseSocial()
        && validSpaceShape(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt is timestamp
        && getAfter(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid))
            .data.uid == request.auth.uid;

      // `resource` es la pre-imagen: autoriza el owner ACTUAL sin get().
      allow update: if canUseSocial()
        && resource.data.ownerUid == request.auth.uid
        && validSpaceShape(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          // Editar nombre/avatar o archivar/reactivar: el owner no cambia.
          (request.resource.data.ownerUid == resource.data.ownerUid)
          // Transferencia a un miembro ACTIVO (su membresía no está en el
          // batch, así que exists() es seguro).
          || (
            resource.data.status == 'active'
            && request.resource.data.status == 'active'
            && request.resource.data.ownerUid != request.auth.uid
            && exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.resource.data.ownerUid))
          )
        );

      // Sin delete en P4: archivar es la única "baja" (nada destructivo
      // para espacios con actividad).
      allow delete: if false;

      match /members/{memberUid} {
        // Cualquier miembro ve la lista de miembros.
        allow read: if canUseSocial() && isSpaceMember(spaceId);

        allow create: if canUseSocial()
          && request.resource.data.keys().hasOnly(['uid', 'joinedAt'])
          && request.resource.data.uid == memberUid
          && request.resource.data.joinedAt is timestamp
          && memberUid == request.auth.uid
          && (
            // (a) Fundador: su membresía al crear el espacio (mismo batch).
            getAfter(/databases/$(database)/documents/spaces/$(spaceId))
                .data.ownerUid == request.auth.uid
            // (b) Aceptar invitación: el receptor se une y el MISMO batch
            // resuelve la invitación a accepted.
            || (spaceData(spaceId).status == 'active'
              && getAfter(/databases/$(database)/documents/spaceInvites/$(spaceId + '_' + request.auth.uid))
                  .data.status == 'accepted')
          );

        // La membresía no tiene campos mutables.
        allow update: if false;

        // Salir (nunca el owner: antes transfiere o archiva) o expulsión
        // por el owner. Solo borra el acceso social futuro.
        allow delete: if canUseSocial()
          && resource.data.uid != spaceData(spaceId).ownerUid
          && (memberUid == request.auth.uid || isSpaceOwner(spaceId));
      }
    }

    match /spaceInvites/{inviteId} {
      // Ve la invitación su receptor o el owner del espacio.
      allow read: if canUseSocial()
        && (resource.data.toUid == request.auth.uid
          || resource.data.fromUid == request.auth.uid);

      // Invita el owner de un espacio ACTIVO a una cuenta con perfil que
      // aún no es miembro. El ID determinista impide duplicados activos.
      allow create: if isSpaceOwner(request.resource.data.spaceId)
        && spaceData(request.resource.data.spaceId).status == 'active'
        && inviteId
          == request.resource.data.spaceId + '_' + request.resource.data.toUid
        && request.resource.data.keys().hasOnly([
          'spaceId', 'spaceName', 'fromUid', 'toUid', 'status',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.spaceName is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.toUid))
        && !exists(/databases/$(database)/documents/spaces/$(request.resource.data.spaceId)/members/$(request.resource.data.toUid));

      allow update: if canUseSocial()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt is timestamp
        && (
          // El RECEPTOR acepta (junto al alta de miembro en el batch,
          // validada arriba) o rechaza. Cancelada ya no se puede aceptar.
          (resource.data.toUid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status in ['accepted', 'rejected'])
          // El owner cancela una pendiente o reenvía tras rechazo o
          // cancelación (reutiliza el doc: sigue sin haber duplicados).
          || (isSpaceOwner(resource.data.spaceId)
            && (
              (resource.data.status == 'pending'
                && request.resource.data.status == 'cancelled')
              || (resource.data.status in ['rejected', 'cancelled']
                && request.resource.data.status == 'pending'
                && spaceData(resource.data.spaceId).status == 'active'
                && !exists(/databases/$(database)/documents/spaces/$(resource.data.spaceId)/members/$(resource.data.toUid)))
            ))
        );

      // Limpieza por el owner (p. ej. invitación obsoleta ya resuelta).
      allow delete: if isSpaceOwner(resource.data.spaceId)
        && resource.data.status != 'pending';
    }

    // "Mis espacios": collection group SOLO sobre la propia membresía.
    match /{path=**}/members/{memberUid} {
      allow read: if canUseSocial()
        && resource.data.uid == request.auth.uid;
    }

    // Tickets vinculados: un miembro del espacio ve el RESUMEN del ticket
    // (doc del ticket; nunca líneas, foto ni el resto de la sesión — la
    // política de privacidad de P4 mantiene el detalle para quien ya tiene
    // acceso a la sesión por los cauces existentes).
    match /{path=**}/tickets/{ticketId} {
      allow read: if canUseSocial()
        && resource.data.get('spaceId', '') != ''
        && isSpaceMember(resource.data.spaceId);
    }

    // ── Sesiones ────────────────────────────────────────────────────────
    match /sessions/{sid} {

      allow create: if canUseCore()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.kind in ['single', 'multi']
        && request.resource.data.status == 'open'
        && request.resource.data.splitModeDefault in ['equal', 'byItem']
        && request.resource.data.shareCode is string
        && request.resource.data.shareCode.size() >= 16
        // Agregados: o ausentes o a cero; a partir de aquí, solo la function.
        && request.resource.data.get('computeVersion', 0) == 0
        && request.resource.data.get('pendingSettlements', 0) == 0
        && request.resource.data.get('balances', {}).size() == 0
        && request.resource.data.get('totals', {}).get('grandTotal', 0) == 0
        && request.resource.data.get('totals', {})
            .get('settlementRequired', 0) == 0
        && request.resource.data.get('totals', {})
            .get('settledConfirmed', 0) == 0
        && request.resource.data.get('totals', {})
            .get('settledMarked', 0) == 0;

      // list del owner (query where ownerUid==uid) y get de invitados.
      allow read: if (signedIn() && resource.data.ownerUid == request.auth.uid)
        || hasGuestAccess(sid);

      allow update: if isOwner(sid)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['ownerUid', 'totals', 'balances', 'computeVersion'])
        && (
          // Abierta: cualquier edición de contenido.
          resource.data.status == 'open'
          // Cerrada/archivada: solo reabrir/archivar (cambio de estado).
          || request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'closedAt', 'updatedAt'])
        );

      allow delete: if isOwner(sid);

      // ── Acceso de invitados (prueba de conocimiento del shareCode) ────
      match /guestAccess/{uid} {
        allow read: if isOwner(sid) || (signedIn() && request.auth.uid == uid);
        allow create: if canUseCore()
          && request.auth.uid == uid
          && isOpen(sid)
          && request.resource.data.shareCode == sessionData(sid).shareCode;
        // Owner revoca (liberar dispositivo); el invitado puede salirse.
        allow delete: if isOwner(sid) || (signedIn() && request.auth.uid == uid);
        allow update: if false;
      }

      // ── Participantes ──────────────────────────────────────────────────
      match /participants/{pid} {
        allow read: if canRead(sid);
        allow create: if isOwner(sid) && isOpen(sid);
        allow delete: if isOwner(sid) && isOpen(sid);
        allow update: if
          (isOwner(sid) && isOpen(sid))
          || (
            hasGuestAccess(sid) && isOpen(sid)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['claimedByDevice'])
            && (
              // Reclamar un nombre libre (o re-reclamar el suyo).
              (request.resource.data.get('claimedByDevice', '') == request.auth.uid
                && resource.data.get('claimedByDevice', '') in ['', request.auth.uid])
              // Liberar SU propio nombre.
              || (resource.data.get('claimedByDevice', '') == request.auth.uid
                && request.resource.data.get('claimedByDevice', '') == '')
            )
          );
      }

      // ── Cuentas ────────────────────────────────────────────────────────
      match /accounts/{aid} {
        allow read: if canRead(sid);
        allow create: if isOwner(sid) && isOpen(sid)
          && !('totals' in request.resource.data);
        allow update: if isOwner(sid) && isOpen(sid)
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['totals']);
        allow delete: if isOwner(sid) && isOpen(sid);

        match /tickets/{tid} {
          allow read: if canRead(sid);
          // spaceId (P4): un ticket pertenece a UN espacio como máximo y
          // solo puede vincularlo el dueño de la sesión a un espacio del
          // que sea miembro. '' o ausente = sin espacio (compatibilidad).
          allow create, update: if isOwner(sid) && isOpen(sid)
            && request.resource.data.grandTotal is int
            && request.resource.data.paidByParticipantId is string
            && (request.resource.data.get('spaceId', '') == ''
              || (request.resource.data.spaceId is string
                && isSpaceMember(request.resource.data.spaceId)));
          allow delete: if isOwner(sid) && isOpen(sid);

          match /lines/{lid} {
            allow read: if canRead(sid);
            allow create, delete: if isOwner(sid) && isOpen(sid);
            allow update: if (isOwner(sid) && isOpen(sid))
              || guestCanEditLine(sid, aid, tid)
              || guestCanEditUnit(sid, aid, tid);
          }
        }
      }

      // ── Liquidaciones ──────────────────────────────────────────────────
      // Normalmente las crea/borra la function (recompute). El OWNER también
      // puede crearlas/borrarlas (necesario para importar backups, RF-91).
      //
      // Confirmar la recepción del dinero (o deshacer esa confirmación) es
      // EXCLUSIVO del receptor real (P2.1): el dispositivo que reclamó el
      // participante `to`. El owner solo confirma si el receptor es SU
      // participante o si nadie ha reclamado ese nombre (un participante sin
      // dispositivo no tiene uid: sin este representante, nadie podría
      // confirmar jamás). Ser el creador del ticket/sesión NO autoriza.
      match /settlements/{stid} {
        allow read: if canRead(sid);
        allow create: if isOwner(sid) && isOpen(sid)
          && request.resource.data.from is string
          && request.resource.data.to is string
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.state in ['pending', 'marked', 'confirmed'];
        allow delete: if isOwner(sid) && isOpen(sid);
        allow update: if isOpen(sid)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['state', 'stateHistory', 'updatedAt'])
          && request.resource.data.state in ['pending', 'marked', 'confirmed']
          && (
            // Toca 'confirmed' (confirmar o deshacer): SOLO el receptor.
            ((resource.data.state == 'confirmed'
                || request.resource.data.state == 'confirmed')
              && isReceiver(sid, resource.data.to))
            // Gestión organizativa pending ↔ marked: el owner.
            || (isOwner(sid)
              && resource.data.state in ['pending', 'marked']
              && request.resource.data.state in ['pending', 'marked'])
            // Invitado deudor: SOLO pending → marked en las suyas.
            || (hasGuestAccess(sid)
              && resource.data.state == 'pending'
              && request.resource.data.state == 'marked'
              && claimedBy(sid, resource.data.from) == request.auth.uid)
          );
      }

      // ── Feed de actividad: append-only ─────────────────────────────────
      match /activity/{eid} {
        allow read: if canRead(sid);
        allow create: if (isOwner(sid) || hasGuestAccess(sid))
          && isOpen(sid)
          && request.resource.data.keys().hasAll(['type', 'at']);
        allow update, delete: if false;
      }
    }

    // Autoasignación de línea por invitado (ver cabecera del archivo).
    // P2.1: el peso son UNIDADES reclamadas (1..unidades de la línea, según
    // quantityMilli entero); en líneas de una unidad sigue siendo 1.
    function guestCanEditLine(sid, aid, tid) {
      let session = sessionData(sid);
      let ticket = get(/databases/$(database)/documents/sessions/$(sid)/accounts/$(aid)/tickets/$(tid)).data;
      let mode = ticket.get('splitModeOverride', session.splitModeDefault);
      let editor = request.resource.data.assignment.get('lastEditorPid', '');
      let oldParts = resource.data.assignment.get('participants', {});
      let newParts = request.resource.data.assignment.get('participants', {});
      let weight = newParts.get(editor, 1);
      let quantityMilli = request.resource.data.get('quantityMilli', 1000);
      return hasGuestAccess(sid)
        && session.status == 'open'
        && mode == 'byItem'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['assignment'])
        // Solo cambió SU entrada del mapa de participantes…
        && editor != ''
        && newParts.diff(oldParts).affectedKeys().hasOnly([editor])
        // …con un peso entero entre 1 y las unidades de la línea…
        && weight is int
        && weight >= 1
        && (weight == 1
          || (quantityMilli % 1000 == 0 && weight * 1000 <= quantityMilli))
        // …el pid editado está reclamado por este dispositivo…
        && claimedBy(sid, editor) == request.auth.uid
        // …y un invitado no puede convertir la línea en "todos".
        && request.resource.data.assignment.type in ['unassigned', 'one', 'shared'];
    }

    // P2.2: un invitado cambia únicamente SU pertenencia a UNA unidad. El
    // mapa anidado permite que dos dispositivos compartan la misma unidad sin
    // sobrescribirse; unitIds limita los identificadores creados por el owner.
    function guestCanEditUnit(sid, aid, tid) {
      let session = sessionData(sid);
      let ticket = get(/databases/$(database)/documents/sessions/$(sid)/accounts/$(aid)/tickets/$(tid)).data;
      let mode = ticket.get('splitModeOverride', session.splitModeDefault);
      let assignment = request.resource.data.assignment;
      let editor = assignment.get('lastEditorPid', '');
      let unitKey = assignment.get('lastEditedUnit', '');
      let oldUnits = resource.data.assignment.get('units', {});
      let newUnits = assignment.get('units', {});
      let oldMembers = oldUnits.get(unitKey, {});
      let newMembers = newUnits.get(unitKey, {});
      let selected = newMembers.get(editor, false);
      return hasGuestAccess(sid)
        && session.status == 'open'
        && mode == 'byItem'
        && resource.data.assignment.get('schemaVersion', 0) == 2
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['assignment'])
        && assignment.keys().hasOnly([
          'type', 'schemaVersion', 'units', 'lastEditorPid', 'lastEditedUnit'
        ])
        && assignment.type == 'units'
        && assignment.schemaVersion == 2
        && editor != ''
        && unitKey != ''
        && resource.data.get('unitIds', ['u0']).hasAny([unitKey])
        && newUnits.diff(oldUnits).affectedKeys().hasOnly([unitKey])
        && newMembers.diff(oldMembers).affectedKeys().hasOnly([editor])
        && selected is bool
        && claimedBy(sid, editor) == request.auth.uid;
    }
  }
}
