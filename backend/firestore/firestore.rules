rules_version = '2';

// M0: denegación total por defecto. La matriz de autorización real
// (ESPECIFICACION.md §13.2) se implementa y testea en M3 con la Emulator Suite.
// Regla de oro del proyecto: solo `allow` explícitos, nunca aperturas amplias.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
