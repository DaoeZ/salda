rules_version = '2';

// Espejo de la política de Firestore para las fotos de tickets:
// owner de la sesión = lectura/escritura; invitado con guestAccess = lectura.
// Límites: JPEG, < 2 MB (la app sube el original ≤1600px q85, holgadamente
// por debajo del límite; ruta receipts/{sid}/{tid}/original.jpg).
service firebase.storage {
  match /b/{bucket}/o {

    function canUseCore() {
      return request.auth != null && (
        request.auth.token.firebase.sign_in_provider == 'anonymous'
        || request.auth.token.email_verified == true
      );
    }

    // Espacio del que NACIÓ la sesión (ADR-030). '' = sesión sin contexto:
    // la foto sigue siendo solo del dueño y sus invitados. El campo solo se
    // escribe junto a `contextModelVersion: 1` —y las Rules de Firestore lo
    // exigen—, así que aquí basta con él y se ahorra una lectura.
    function sessionSpaceId(sid) {
      return firestore.get(/databases/(default)/documents/sessions/$(sid))
        .data.get('spaceId', '');
    }

    // A11b: la foto es la EVIDENCIA del gasto, no un archivo privado de
    // quien la subió. Cualquier miembro del GRUPO puede abrirla para
    // comprobar que la línea interpretada coincide con el papel. Espejo
    // exacto de `auditableByGroup` en firestore.rules — si una capa se
    // mueve, la otra deja de cuadrar y la auditoría se rompe a medias.
    //
    // El espacio se resuelve UNA vez y viaja como parámetro: repetir
    // `sessionSpaceId()` dentro de la condición multiplicaba las lecturas
    // de Firestore por cada descarga de una foto.
    function auditableByGroup(sid) {
      return memberOfGroup(sessionSpaceId(sid));
    }

    function memberOfGroup(spaceId) {
      return spaceId != ''
        && firestore.exists(/databases/(default)/documents/spaces/$(spaceId))
        && firestore.get(/databases/(default)/documents/spaces/$(spaceId))
            .data.get('kind', 'group') == 'group'
        && firestore.exists(/databases/(default)/documents/spaces/$(spaceId)/members/$(request.auth.uid));
    }

    // A11d: la foto es parte de la auditoría de UNA deuda, así que quien ya
    // no es miembro la conserva exactamente para los tickets en los que
    // participó económicamente. Espejo exacto de `hasTicketHistory` en
    // firestore.rules — la ruta ya es por ticket, así que el permiso se
    // acota solo. Ni un ticket más: `{tid}` viene de la ruta del archivo.
    function hasTicketHistory(sid, tid) {
      return firestore.exists(/databases/(default)/documents/sessions/$(sid)/ticketEntitlements/$(tid + '_' + request.auth.uid));
    }

    match /receipts/{sid}/{tid}/{file} {
      allow read: if request.auth != null && (
        firestore.get(/databases/(default)/documents/sessions/$(sid)).data.ownerUid == request.auth.uid
        || firestore.exists(/databases/(default)/documents/sessions/$(sid)/guestAccess/$(request.auth.uid))
        || auditableByGroup(sid)
        || hasTicketHistory(sid, tid)
      );
      allow write: if canUseCore()
        && firestore.get(/databases/(default)/documents/sessions/$(sid)).data.ownerUid == request.auth.uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg');
    }

    // Foto de perfil (P2 deja la infraestructura lista; la UI de subida
    // llegará después). Pública dentro del producto, como profiles/{uid}.
    match /avatars/{uid}/avatar.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
