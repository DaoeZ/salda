<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del arranque. Debe coincidir con el token `background` claro para
     que no haya un destello blanco antes del primer fotograma de Flutter.
     Fuente: packages/design_tokens/assets/design_tokens.json -->
<resources>
    <color name="saldaBackground">#F7F6F2</color>
    <!-- Capa de FONDO del Adaptive Icon: el verde principal de la marca.
         Es un color y no un archivo, para que el icono no pueda separarse de
         la paleta. El foreground llegará cuando el símbolo esté aprobado
         (ver apps/mobile/assets/brand/README.md). -->
    <color name="saldaLauncherBackground">#0B5E4E</color>
</resources>
