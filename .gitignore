# --- Dart / Flutter ---
.dart_tool/
.packages
build/
*.g.dart.bak
.flutter-plugins
.flutter-plugins-dependencies
# Con pub workspace, el único lockfile real es el de la raíz (se commitea).
pubspec.lock
!/pubspec.lock

# --- Android ---
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/android/app/.cxx/
*.keystore
*.jks
# Excepción: clave de DEPURACIÓN compartida (contraseña pública "android").
# Se versiona a propósito para que la huella SHA-1 del APK de desarrollo sea
# la misma en toda máquina y en CI, y pueda registrarse una sola vez en el
# proyecto Firebase. Jamás debe usarse para firmar una release.
!apps/mobile/android/app/salda-debug.keystore
key.properties

# --- iOS / macOS ---
apps/mobile/ios/Pods/
apps/mobile/ios/.symlinks/
apps/mobile/ios/Flutter/ephemeral/
**/xcuserdata/

# --- Node ---
node_modules/
*.tsbuildinfo

# --- Web build ---
apps/guest_web/dist/

# --- Functions build ---
backend/functions/lib/

# --- Firebase ---
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
pubsub-debug.log
storage-debug.log
*-debug.log
emulator-data/

# --- IDE / OS ---
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# --- Secrets (never commit) ---
*.env
.env.*
# Config pública de cliente de la web (no es secreto): SÍ se commitea.
!apps/guest_web/.env.salda-dev
!apps/guest_web/.env.production.example
google-services.json
GoogleService-Info.plist
serviceAccount*.json
# firebase_options.dart SÍ se commitea: es config pública de cliente
# (la seguridad la dan las reglas + App Check).
